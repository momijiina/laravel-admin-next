{
    "name": "encore/laravel-admin",
    "description": "laravel admin",
    "type": "library",
    "keywords": ["laravel", "admin", "grid", "form"],
    "homepage": "https://github.com/z-song/laravel-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "zsong",
            "email": "zosong@126.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/dom-crawler": "~3.1|~4.0|~5.0|^6.4.40",
        "laravel/framework": ">=5.5",
        "doctrine/dbal": "^2.13.9 || ^3.10.6"
    },
    "autoload": {
        "psr-4": {
            "Encore\\Admin\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "scripts": {
        "test": "@php tests/browserkit/vendor/bin/phpunit --configuration tests/browserkit/phpunit.xml",
        "test:integration": "@php tests/integration/vendor/bin/phpunit --configuration tests/integration/phpunit.xml"
    },
    "suggest": {
        "intervention/image": "Required for image transformations and thumbnails (^3.11.9); ordinary uploads do not need it.",
        "spatie/eloquent-sortable": "Required to built orderable gird."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Encore\\Admin\\AdminServiceProvider"
            ],
            "aliases": {
                "Admin": "Encore\\Admin\\Facades\\Admin"
            }
        }
    }
}
