{
    "name": "laravel-admin-next/integration-tests",
    "description": "Isolated real Laravel integration tests for the local package",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "encore/laravel-admin": "dev-under-test",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "encore/laravel-admin": "dev-under-test"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": false
    },
    "scripts": {
        "test": "phpunit"
    }
}
